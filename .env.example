# Copy to .env for a local build: cp .env.example .env
# Every value is optional. Left empty, the app runs with a sample paywall
# (purchasing off) and no crash reporting. Never commit .env, and never put
# a real value in this file. EAS and Codemagic keep their own copies.

# RevenueCat's public Android SDK key (starts with goog_).
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Sentry's public DSN. Nothing is sent until the user opts in.
EXPO_PUBLIC_SENTRY_DSN=

# Build time only, for uploading source maps from preview and production builds.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
