# EAS reads this file instead of .gitignore when it exists, so everything
# .gitignore ignores is repeated here. Keep the two in step.

# dependencies
node_modules/

# expo
.expo/
dist/

# native
/android/
/ios/

# environment
.env
.env.*

# signing
*.keystore
*.jks

# credentials: EAS local credentials, Play service accounts, keys and certificates
credentials.json
*service-account*.json
*.pem
*.p12
*.p8
*.key

# misc
.DS_Store
*.log
.agents/
.claude/
skills-lock.json

# The public website is a separate Next.js project. The app build never needs it.
/website/
