{
  "expo": {
    "name": "Paceball",
    "slug": "paceball",
    "version": "1.0.0",
    "scheme": "paceball",
    "android": {
      "package": "com.paceball.app",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "2187a0d6-2bcb-4757-9e6c-18c9e7c5e8e4"
      }
    },
    "owner": "visualsbybasit",
    "plugins": [
      "expo-router",
      "expo-sharing",
      ["expo-media-library", {
        "photosPermission": false,
        "savePhotosPermission": "Allow Paceball to save delivery images to your gallery.",
        "granularPermissions": [],
        "isAccessMediaLocationEnabled": false
      }]
    ]
  }
}
